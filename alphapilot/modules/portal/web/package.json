{
  "name": "alphapilot-portal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:interaction": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --project=chromium --project=mobile-chromium",
    "test:e2e:cross": "npm run build && playwright test --project=firefox --project=webkit",
    "test:e2e:llm": "npm run build && playwright test e2e/llm.spec.ts --project=chromium",
    "docs:screenshots": "npm run build && ALPHAPILOT_GENERATE_DOC_SCREENSHOTS=1 ALPHAPILOT_PORTAL_QA_ROOT=/tmp/alphapilot-docs-fixture playwright test e2e/docs-screenshots.spec.ts --project=chromium",
    "docs:mermaid": "node scripts/validate-docs-mermaid.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "plotly.js-finance-dist-min": "^2.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.30.1",
    "typescript": "^5.5.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^24.1.3",
    "mermaid": "^11.16.0",
    "vitest": "^3.2.6"
  }
}
